---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import DownloadBtn from '../components/DownloadBtn.astro';
import ThemePanel from '../components/ThemePanel.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (name: string) => `${base}/assets/images/social-summit/social-summit-${name}.png`;
---

<BrandLayout
  title="Social Summit"
  eyebrow="Events"
>

  <!-- LOGOS -->
  <div class="section">
    <div class="section-label">Logos</div>

    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <img src={img('navy')} style="max-width:82%;max-height:80%;width:auto;height:auto;" alt="Social Summit navy" />
      </LogoTile>
      <LogoTile bg="light" style="background:#161A48;border:none;">
        <img src={img('white')} style="max-width:82%;max-height:80%;width:auto;height:auto;" alt="Social Summit white" />
      </LogoTile>
      <LogoTile bg="light" style="background:#161A48;border:none;">
        <img src={img('pink')} style="max-width:82%;max-height:80%;width:auto;height:auto;" alt="Social Summit pink gradient" />
      </LogoTile>
      <LogoTile bg="light">
        <img src={img('navy-pink')} style="max-width:82%;max-height:80%;width:auto;height:auto;" alt="Social Summit navy and pink" />
      </LogoTile>
    </LogoGrid>

    <div class="btn-row" style="margin-top:20px;">
      <DownloadBtn href="/assets/downloads/Social_Summit_Logos.zip" label="Download Social Summit Logos" />
    </div>
  </div>

  <!-- COLORS -->
  <div class="section">
    <div class="section-label">Colors</div>
    <div class="color-grid">
      <div class="color-card">
        <div class="color-swatch" style="background:#161A48;"></div>
        <div class="color-info">
          <div class="color-name">Navy</div>
          <div class="color-values">Hex: #161A48</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#3E8FFA;"></div>
        <div class="color-info">
          <div class="color-name">Blue</div>
          <div class="color-values">Hex: #3E8FFA</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#E47ED7;"></div>
        <div class="color-info">
          <div class="color-name">Pink</div>
          <div class="color-values">Hex: #E47ED7</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#FFFFFF;border:1px solid #e8e8e8;"></div>
        <div class="color-info">
          <div class="color-name">White</div>
          <div class="color-values">Hex: #FFFFFF</div>
        </div>
      </div>
    </div>
  </div>

  <!-- TYPOGRAPHY -->
  <div class="section">
    <div class="section-label">Typefaces</div>

    <div class="type-block">
      <div class="type-block-label">Headline — GC Horizon Bold Condensed</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-family:'GC Horizon',sans-serif;font-weight:700;text-transform:uppercase;">Social<br>Summit</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Script — Mistrully</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-family:'Mistrully',cursive;font-weight:400;">Social Summit</div>
      </div>
    </div>

    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Social_Summit_Fonts.zip" label="Download Social Summit Fonts" />
    </div>
  </div>

  <!-- THEME -->
  <div class="section">
    <div class="section-label">Theme</div>
    <ThemePanel
      brandName="Social Summit"
      colors={[
        { name: 'Navy', hex: '#161A48', role: 'Primary' },
        { name: 'Blue', hex: '#3E8FFA', role: 'Secondary' },
        { name: 'Pink', hex: '#E47ED7', role: 'Accent' },
        { name: 'White', hex: '#FFFFFF', role: 'Neutral' },
      ]}
      fonts={[
        { name: 'GC Horizon', role: 'Headline' },
        { name: 'Mistrully', role: 'Script' },
      ]}
    />
  </div>

</BrandLayout>
