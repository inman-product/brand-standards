---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import DownloadBtn from '../components/DownloadBtn.astro';
import PhotoWidget from '../components/PhotoWidget.astro';
import InmanSelectHorizontal from '../components/logos/InmanSelectHorizontal.astro';
import InmanSelectStacked from '../components/logos/InmanSelectStacked.astro';
import SelectIcon from '../components/logos/SelectIcon.astro';
---

<BrandLayout
  title="Select"
  eyebrow="Products"
  titleSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1449.35 173.91" style="width:300px;height:auto;display:block;margin-top:6px;" aria-label="Inman Select"><path fill="#0a84ff" d="M817.87,85.85v2.7h-27.91v-2.34c0-8.82-7.2-16.2-24.31-16.2-13.5,0-20.89,5.22-20.89,12.6,0,8.64,6.66,10.98,28.27,16.38,36.37,7.56,46.45,16.56,46.45,36.55,0,23.77-21.97,36.91-51.86,36.91-35.65,0-52.76-15.48-52.76-39.07v-3.78h27.73v1.98c0,11.7,9,18.73,26.11,18.73,14.4,0,22.87-4.86,22.87-12.96,0-9.18-5.4-11.16-29.35-17.11-34.39-7.02-45.37-16.02-45.37-36.37,0-21.43,19.27-36.01,49.88-36.01,34.39,0,51.14,15.84,51.14,37.99Z"/><path fill="#0a84ff" d="M934.9,50.2v22.87h-66.26v25.57h51.14v21.25h-51.14v27.37h66.26v22.87h-93.27V50.2h93.27Z"/><path fill="#0a84ff" d="M986.04,50.2v95.97h58.16v23.95h-85.89V50.2h27.73Z"/><path fill="#0a84ff" d="M1156.73,50.2v22.87h-66.26v25.57h51.14v21.25h-51.14v27.37h66.26v22.87h-93.27V50.2h93.27Z"/><path fill="#0a84ff" d="M1280.25,89.63v4.68h-27.37v-3.6c0-11.16-8.82-20.17-23.59-20.17-19.45,0-28.99,13.86-28.99,32.05v14.94c0,17.65,9.54,32.23,28.99,32.23,14.76,0,23.59-9,23.59-20.17v-3.6h27.37v4.68c0,23.41-16.92,42.13-51.13,42.13s-56.54-22.87-56.54-55.64v-14.04c0-32.77,21.25-55.64,56.9-55.64s50.78,18.37,50.78,42.13Z"/><path fill="#0a84ff" d="M1398.72,50.2v23.59h-39.61v96.33h-27.37v-96.33h-39.79v-23.59h106.77Z"/><path fill="#161a48" d="M61.39,168.84v1.28c-7.41-.51-18.13-.51-29.11-.51s-21.45,0-29.88.51v-1.28c10.72-4.34,12.51-9.45,12.51-38.56v-42.39c0-26.56-1.79-30.64-12.51-37.28v-1.28c17.88,0,30.13-.25,47.24-.77v81.97c0,28.86,1.53,33.96,11.75,38.31Z"/><path fill="#161a48" d="M204.39,170.12c-8.43-.51-17.62-.51-28.86-.51s-20.94,0-28.6.51v-1.28c9.45-4.34,11.24-9.45,11.24-36.77v-41.62c0-14.56-7.15-21.45-18.64-21.45-10.47,0-21.71,7.15-21.71,21.71v41.63c0,27.07,1.53,32.18,11.24,36.52v1.28c-7.66-.51-17.36-.51-28.6-.51s-20.94,0-29.37.51v-1.28c10.21-4.34,12-9.45,12-36.77v-44.18c0-26.56-1.79-30.64-12-37.28v-1.28c17.88,0,29.88-.25,46.73-.77v24.77c6.89-15.32,21.45-27.32,39.84-27.32,24.52,0,35.24,16.09,35.24,38.82v47.24c0,27.32,1.79,32.43,11.49,36.77v1.28Z"/><path fill="#161a48" d="M417.86,170.12c-8.17-.51-17.62-.51-28.86-.51s-20.94,0-28.35.51v-1.28c9.45-4.34,10.98-9.45,10.98-36.77v-41.62c0-14.56-6.9-21.45-17.88-21.45-9.96,0-20.68,7.15-20.68,21.71v41.37c0,27.32,1.79,32.43,12,36.77v1.28c-8.17-.51-18.13-.51-29.37-.51s-20.94,0-28.6.51v-1.28c9.7-4.34,11.24-9.45,11.24-36.77v-41.62c0-14.56-6.89-21.45-17.88-21.45-9.96,0-20.68,7.15-20.68,21.71v41.63c0,27.07,1.53,32.18,11.24,36.52v1.28c-7.41-.51-17.36-.51-28.6-.51s-21.2,0-29.37.51v-1.28c10.21-4.34,12-9.45,12-36.77v-44.18c0-26.56-1.79-30.64-12-37.28v-1.28c17.62,0,30.13-.25,46.73-.77v24.52c6.89-15.32,21.2-27.07,38.82-27.07,20.17,0,30.9,11.49,33.71,28.6,6.38-16.09,21.2-28.6,39.58-28.6,24,0,34.47,16.09,34.47,38.82v47.24c0,27.32,2.04,32.43,11.49,36.77v1.28Z"/><path fill="#161a48" d="M493.69,157.35c-12.77,11.24-22.22,15.58-35.5,15.58-18.39,0-30.13-12.26-30.13-31.41,0-24,17.88-36.26,65.63-39.84v-15.83c0-14.56-6.64-19.66-17.62-19.66s-21.71,6.39-35.5,22.22l-1.02-.26c-.25-10.47-1.02-19.41-2.3-28.6,13.28-7.41,31.67-13.53,48.78-13.53,26.05,0,41.62,12.51,41.62,41.88v44.43c0,27.32,1.79,32.43,11.49,36.26v1.28c-17.62,0-28.6.26-45.45.77v-13.28ZM476.84,156.07c4.85,0,9.96-1.79,16.85-5.62v-34.22c-26.81,2.55-32.43,10.98-32.43,22.47s5.62,17.36,15.58,17.36Z"/><path fill="#161a48" d="M680.61,170.12c-8.43-.51-17.62-.51-28.86-.51s-20.94,0-28.6.51v-1.28c9.45-4.34,11.24-9.45,11.24-36.77v-41.62c0-14.56-7.15-21.45-18.64-21.45-10.47,0-21.71,7.15-21.71,21.71v41.63c0,27.07,1.53,32.18,11.24,36.52v1.28c-7.66-.51-17.36-.51-28.6-.51s-20.94,0-29.37.51v-1.28c10.21-4.34,12-9.45,12-36.77v-44.18c0-26.56-1.79-30.64-12-37.28v-1.28c17.88,0,29.88-.25,46.73-.77v24.77c6.89-15.32,21.45-27.32,39.84-27.32,24.52,0,35.24,16.09,35.24,38.82v47.24c0,27.32,1.79,32.43,11.49,36.77v1.28Z"/><circle fill="#0a84ff" cx="31.1" cy="19.16" r="16.97"/></svg>`}
>

  <!-- LOGOS -->
  <div class="section">
    <div class="section-label">Logos</div>

    <div class="logo-subsection-label">Horizontal</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <InmanSelectHorizontal fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light">
        <InmanSelectHorizontal fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark">
        <InmanSelectHorizontal fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue">
        <InmanSelectHorizontal fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">Stacked</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <InmanSelectStacked fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light" tall>
        <InmanSelectStacked fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark" tall>
        <InmanSelectStacked fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue" tall>
        <InmanSelectStacked fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Inman_Select_Logo.zip" label="Download Select Logos" />
    </div>
  </div>

  <!-- ICONS -->
  <div class="section">
    <div class="section-label" id="icons-label">Icons — Light Mode</div>
    <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:flex-end;">
      <!-- Dark icon (shown in light mode) -->
      <div class="select-icon-light" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#161a48" dotFill="#0a84ff" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue Duo</span>
      </div>
      <div class="select-icon-light" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#0a84ff" dotFill="#0a84ff" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue</span>
      </div>
      <div class="select-icon-light" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#adafb2" dotFill="#adafb2" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Gray</span>
      </div>
      <div class="select-icon-light" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--dark);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#fff" dotFill="#0a84ff" solid />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue Solid</span>
      </div>
      <!-- Light icon (shown in dark mode) -->
      <div class="select-icon-dark" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#fff" dotFill="#0a84ff" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue Duo</span>
      </div>
      <div class="select-icon-dark" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#0a84ff" dotFill="#0a84ff" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue</span>
      </div>
      <div class="select-icon-dark" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#adafb2" dotFill="#adafb2" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Gray</span>
      </div>
      <div class="select-icon-dark" style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--dark);display:flex;align-items:center;justify-content:center;">
          <SelectIcon fill="#fff" dotFill="#0a84ff" solid />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue Solid</span>
      </div>
    </div>
    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Inman_Select_Icons.zip" label="Download Select Icons" />
    </div>
  </div>

  <PhotoWidget />

</BrandLayout>

<style>
  .select-icon-dark { display: none; }
  .select-icon-light { display: flex; }
  :global([data-theme="dark"]) .select-icon-dark { display: flex; }
  :global([data-theme="dark"]) .select-icon-light { display: none; }
</style>

<script>
  function updateIconsLabel() {
    const label = document.getElementById('icons-label');
    if (!label) return;
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    label.textContent = isDark ? 'Icons — Dark Mode' : 'Icons — Light Mode';
  }

  updateIconsLabel();

  const observer = new MutationObserver(updateIconsLabel);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
