---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import DownloadBtn from '../components/DownloadBtn.astro';
import InmanConnectSDHorizontal from '../components/logos/InmanConnectSDHorizontal.astro';
import InmanConnectSDStacked from '../components/logos/InmanConnectSDStacked.astro';
---

<BrandLayout
  title="Inman Connect San Diego"
  eyebrow="Events"
>

  <!-- LOGOS -->
  <div class="section">
    <div class="section-label">Logos</div>

    <div class="logo-subsection-label">Horizontal</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <InmanConnectSDHorizontal fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light">
        <InmanConnectSDHorizontal fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark">
        <InmanConnectSDHorizontal fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue">
        <InmanConnectSDHorizontal fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">Stacked</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <InmanConnectSDStacked fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light" tall>
        <InmanConnectSDStacked fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark" tall>
        <InmanConnectSDStacked fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue" tall>
        <InmanConnectSDStacked fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Inman_Connect_SD_Logos.zip" label="Download Connect SD Logos" />
    </div>
  </div>


</BrandLayout>
