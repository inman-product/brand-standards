---
import BrandLayout from '../layouts/BrandLayout.astro';
import ThemePanel from '../components/ThemePanel.astro';
---

<BrandLayout
  title="Developer Guide"
  eyebrow="Inman"
>
  <div class="section">
    <ThemePanel
      brandName="Inman"
      mode="light"
      colors={[
        { name: 'Bright Blue', hex: '#0a84ff', role: 'Primary' },
        { name: 'Dark Blue', hex: '#161a48', role: 'Secondary' },
        { name: 'Red', hex: '#ff0a0a', role: 'Accent' },
      ]}
      fonts={[
        { name: 'HEX Franklin', role: 'Headline' },
        { name: 'HEX Franklin', role: 'Body' },
        { name: 'Harriet Display', role: 'Editorial' },
        { name: 'Tungsten', role: 'Impact' },
      ]}
      downloadHref="/assets/downloads/Inman_Dev_Guide.md"
    />
  </div>
</BrandLayout>
