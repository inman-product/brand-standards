---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import DownloadBtn from '../components/DownloadBtn.astro';
import InmanAwardsHorizontal from '../components/logos/InmanAwardsHorizontal.astro';
import InmanAwardsStacked from '../components/logos/InmanAwardsStacked.astro';
---

<BrandLayout
  title="Awards"
  eyebrow="Products"
>
  <div class="section">
    <div class="section-label">Logos</div>

    <div class="logo-subsection-label">Horizontal</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <InmanAwardsHorizontal fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light">
        <InmanAwardsHorizontal fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark">
        <InmanAwardsHorizontal fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue">
        <InmanAwardsHorizontal fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">Stacked</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <InmanAwardsStacked fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light" tall>
        <InmanAwardsStacked fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark" tall>
        <InmanAwardsStacked fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue" tall>
        <InmanAwardsStacked fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>
    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Inman_Awards_Logo.zip" label="Download Awards Logos" />
    </div>
  </div>

  <div class="section">
    <div class="section-label">Award marks</div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">Power Players</span>
      </LogoTile>
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">Marketing All-Stars</span>
      </LogoTile>
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">Innovators</span>
      </LogoTile>
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">Future Leaders in Real Estate</span>
      </LogoTile>
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">Best of Finance</span>
      </LogoTile>
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">Golden I Club</span>
      </LogoTile>
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">AI Awards</span>
      </LogoTile>
      <LogoTile bg="light" style="height:140px;flex-direction:column;gap:10px;">
        <div class="coming-soon-badge">SVG pending</div>
        <span class="award-mark-label">Best of Proptech</span>
      </LogoTile>
    </div>
  </div>

</BrandLayout>

<style>
  .award-mark-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
