---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import DownloadBtn from '../components/DownloadBtn.astro';
import InmanAwardsHorizontal from '../components/logos/InmanAwardsHorizontal.astro';
import InmanAwardsStacked from '../components/logos/InmanAwardsStacked.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BrandLayout
  title="Inman Awards"
  eyebrow="Products"
>
  <div class="section">
    <div class="section-label">Logos</div>

    <div class="logo-subsection-label">Horizontal</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <InmanAwardsHorizontal fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light">
        <InmanAwardsHorizontal fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark">
        <InmanAwardsHorizontal fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue">
        <InmanAwardsHorizontal fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">Stacked</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <InmanAwardsStacked fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light" tall>
        <InmanAwardsStacked fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark" tall>
        <InmanAwardsStacked fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue" tall>
        <InmanAwardsStacked fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>
    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Inman_Awards_Logo.zip" label="Download Awards Logos" />
    </div>
  </div>

  <div class="section">
    <div class="section-label">Award marks</div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_Power_Player.svg`} class="award-img" alt="Power Players" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_MLS_Power_Executive.svg`} class="award-img" alt="MLS Power Executive" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_NY_Power_Broker.svg`} class="award-img" alt="NY Power Broker" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_Marketing_All-Star.svg`} class="award-img" alt="Marketing All-Stars" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_Innovator.svg`} class="award-img" alt="Innovators" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_Future_Leaders.svg`} class="award-img" alt="Future Leaders in Real Estate" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_Best_In_Finance.svg`} class="award-img" alt="Best of Finance" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_Golden_I_Club.svg`} class="award-img" alt="Golden I Club" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_AI_Awards.svg`} class="award-img" alt="AI Awards" />
      </LogoTile>
      <LogoTile bg="light" style="height:140px;">
        <img src={`${base}/assets/images/Inman_Awards_Inman_Best_Of_Proptech.svg`} class="award-img" alt="Best of Proptech" />
      </LogoTile>
    </div>
    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Inman_Award_Category_Logos.zip" label="Download Award Category Logos" />
    </div>
  </div>

</BrandLayout>

<style is:global>
  .award-img {
    max-height: 85px;
    max-width: 90%;
    width: auto;
    height: auto;
  }
</style>