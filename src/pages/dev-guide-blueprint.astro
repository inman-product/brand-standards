---
import BrandLayout from '../layouts/BrandLayout.astro';
import ThemePanel from '../components/ThemePanel.astro';
---

<BrandLayout
  title="Developer Guide"
  eyebrow="Blueprint"
>
  <div class="section">
    <ThemePanel
      brandName="Blueprint"
      mode="dark"
      colors={[
        { name: 'Midnight', hex: '#00015D', role: 'Primary' },
        { name: 'Cobalt', hex: '#002ef6', role: 'Secondary' },
        { name: 'Azure', hex: '#54B9FF', role: 'Tertiary' },
        { name: 'Lemon', hex: '#fee759', role: 'Accent' },
        { name: 'Cherry', hex: '#e63951', role: 'Accent' },
        { name: 'Prince', hex: '#9B2FAE', role: 'Accent' },
        { name: 'Onyx', hex: '#0F0F0F', role: 'Neutral' },
        { name: 'White', hex: '#FFFFFF', role: 'Neutral' },
      ]}
      fonts={[
        { name: 'CA Saygon Text', role: 'Headline' },
        { name: 'Helvetica Neue', role: 'Body' },
      ]}
      downloadHref="/assets/downloads/Blueprint_Dev_Guide.md"
    />
  </div>
</BrandLayout>
