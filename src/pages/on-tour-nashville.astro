---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BrandLayout
  title="Inman On Tour — Nashville"
  eyebrow="Events"
>
  <div class="section">
    <div class="section-label">Logos</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <img src={`${base}/assets/images/web_logo_o_date.png`} style="width:82%;height:auto;display:block;" alt="Inman On Tour Nashville" />
      </LogoTile>
      <LogoTile bg="dark" tall>
        <img src={`${base}/assets/images/IOTN26_white_02.png`} style="width:82%;height:auto;display:block;" alt="Inman On Tour Nashville white" />
      </LogoTile>
    </LogoGrid>
  </div>

</BrandLayout>
