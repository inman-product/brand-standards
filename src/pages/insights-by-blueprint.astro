---
import BrandLayout from '../layouts/BrandLayout.astro';
---

<BrandLayout
  title="Insights By Blueprint"
  eyebrow="Events"
>

  <div class="section">
    <div class="section-label">Logos</div>
    <p style="color:var(--text-muted);">Coming soon.</p>
  </div>

  <!-- FAVICON -->
  <div class="section">
    <div class="section-label">Favicon</div>
    <p style="color:var(--text-muted);">Coming soon.</p>
  </div>

  <!-- COLORS -->
  <div class="section">
    <div class="section-label">Colors</div>
    <div class="color-grid">
      <div class="color-card">
        <div class="color-swatch" style="background:#021b96;"></div>
        <div class="color-info">
          <div class="color-name">Dark Blue</div>
          <div class="color-values">Hex: #021b96<br>RGB: 2, 27, 150<br>CMYK: 99, 82, 0, 41<br>HSB: 230, 98.67, 58.82</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#0089ff;"></div>
        <div class="color-info">
          <div class="color-name">Bright Blue</div>
          <div class="color-values">Hex: #0089ff<br>RGB: 0, 137, 255<br>CMYK: 100, 46, 0, 0<br>HSB: 207.76, 100, 100</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#1c00ff;"></div>
        <div class="color-info">
          <div class="color-name">Electric Purple</div>
          <div class="color-values">Hex: #1c00ff<br>RGB: 28, 0, 255<br>CMYK: 89, 100, 0, 0<br>HSB: 246.59, 100, 100</div>
        </div>
      </div>
    </div>
  </div>

  <!-- TYPOGRAPHY — PRIMARY -->
  <div class="section">
    <div class="section-label">Primary typeface</div>

    <div class="type-block">
      <div class="type-block-label">Display — Font TBD Bold</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-weight:700;">Insights start<br>here.</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Weights</div>
      <div class="type-specimen">
        <div class="specimen-weights">
          <div class="weight-item"><div class="weight-char" style="font-weight:400;">Aa</div><div class="weight-label">Regular</div></div>
          <div class="weight-item"><div class="weight-char" style="font-weight:500;">Aa</div><div class="weight-label">Medium</div></div>
          <div class="weight-item"><div class="weight-char" style="font-weight:600;">Aa</div><div class="weight-label">SemiBold</div></div>
          <div class="weight-item"><div class="weight-char" style="font-weight:700;">Aa</div><div class="weight-label">Bold</div></div>
        </div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Body — Font TBD Regular</div>
      <div class="type-specimen">
        <div class="specimen-body">Insights By Blueprint is the premier event for real estate data and analytics professionals. Expert panels, workshops, and networking keep you ahead of the curve.<br><br><strong>Semibold for emphasis.</strong> Always pair display type with adequate white space to let headings breathe.</div>
      </div>
    </div>
  </div>

  <!-- TYPOGRAPHY — SECONDARY -->
  <div class="section">
    <div class="section-label">Secondary typeface</div>

    <div class="type-block">
      <div class="type-block-label">Display — Font TBD Bold</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-weight:700;font-style:italic;">Insights start<br>here.</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Weights</div>
      <div class="type-specimen">
        <div class="specimen-weights">
          <div class="weight-item"><div class="weight-char" style="font-weight:400;">Aa</div><div class="weight-label">Regular</div></div>
          <div class="weight-item"><div class="weight-char" style="font-weight:500;">Aa</div><div class="weight-label">Medium</div></div>
          <div class="weight-item"><div class="weight-char" style="font-weight:700;">Aa</div><div class="weight-label">Bold</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- TYPOGRAPHY — IMPACT -->
  <div class="section">
    <div class="section-label">Impact typeface</div>

    <div class="type-block">
      <div class="type-block-label">Display — Font TBD Bold</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-weight:700;text-transform:uppercase;">Insights start<br>here.</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Weights</div>
      <div class="type-specimen">
        <div class="specimen-weights">
          <div class="weight-item"><div class="weight-char" style="font-weight:700;">Aa</div><div class="weight-label">Bold</div></div>
        </div>
      </div>
    </div>
  </div>

</BrandLayout>
