---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import DownloadBtn from '../components/DownloadBtn.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BrandLayout
  title="Insights By Blueprint"
  eyebrow="Events"
>

  <div class="section">
    <div class="section-label">Logos</div>

    <div class="logo-subsection-label">Primary</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <img src={`${base}/assets/images/Insights.svg`} style="width:82%;height:auto;" alt="Insights By Blueprint" />
      </LogoTile>
      <LogoTile bg="light" style="background:#1c00ff;border:none;">
        <img src={`${base}/assets/images/Insights_rev.svg`} style="width:82%;height:auto;" alt="Insights By Blueprint reversed" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">Horizontal</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <img src={`${base}/assets/images/Insights_by_Blueprint_Horizontal.svg`} style="width:82%;height:auto;" alt="Insights By Blueprint horizontal" />
      </LogoTile>
      <LogoTile bg="light" style="background:#1c00ff;border:none;">
        <img src={`${base}/assets/images/Insights_by_Blueprint_Horizontal_White.svg`} style="width:82%;height:auto;" alt="Insights By Blueprint horizontal white" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">With tagline</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <img src={`${base}/assets/images/Insights_tag.svg`} style="width:82%;height:auto;" alt="Insights By Blueprint with tagline" />
      </LogoTile>
      <LogoTile bg="light" tall style="background:#1c00ff;border:none;">
        <img src={`${base}/assets/images/Insights_tag_rev.svg`} style="width:82%;height:auto;" alt="Insights By Blueprint with tagline reversed" />
      </LogoTile>
    </LogoGrid>

    <div class="btn-row" style="margin-top:20px;">
      <DownloadBtn href="/assets/downloads/Insights_By_Blueprint_Logos.zip" label="Download Insights Logos" />
    </div>
  </div>

  <!-- FAVICON -->
  <div class="section">
    <div class="section-label">Favicon</div>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start;">

      <!-- Dark bg (primary use) -->
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:120px;height:120px;border-radius:12px;background:#ffffff;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" style="width:72px;height:72px;">
            <polygon fill="#1c00ff" points="18.67 11.34 29.2 17.38 42.81 9.55 31.48 4.11 18.67 11.34"/>
            <polygon fill="#021b96" points="35.37 61.24 45.92 55.16 45.92 14.85 35.37 20.93 35.37 61.24"/>
            <polygon fill="#0089ff" points="18.66 11.36 18.66 51.59 29.2 57.68 29.2 17.38 18.66 11.36"/>
          </svg>
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">64×64</span>
      </div>

      <!-- Rendered sizes -->
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:120px;height:120px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;gap:16px;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" style="width:48px;height:48px;border-radius:8px;">
            <rect width="64" height="64" fill="#ffffff"/>
            <polygon fill="#1c00ff" points="18.67 11.34 29.2 17.38 42.81 9.55 31.48 4.11 18.67 11.34"/>
            <polygon fill="#021b96" points="35.37 61.24 45.92 55.16 45.92 14.85 35.37 20.93 35.37 61.24"/>
            <polygon fill="#0089ff" points="18.66 11.36 18.66 51.59 29.2 57.68 29.2 17.38 18.66 11.36"/>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" style="width:32px;height:32px;border-radius:6px;">
            <rect width="64" height="64" fill="#ffffff"/>
            <polygon fill="#1c00ff" points="18.67 11.34 29.2 17.38 42.81 9.55 31.48 4.11 18.67 11.34"/>
            <polygon fill="#021b96" points="35.37 61.24 45.92 55.16 45.92 14.85 35.37 20.93 35.37 61.24"/>
            <polygon fill="#0089ff" points="18.66 11.36 18.66 51.59 29.2 57.68 29.2 17.38 18.66 11.36"/>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" style="width:16px;height:16px;border-radius:3px;">
            <rect width="64" height="64" fill="#ffffff"/>
            <polygon fill="#1c00ff" points="18.67 11.34 29.2 17.38 42.81 9.55 31.48 4.11 18.67 11.34"/>
            <polygon fill="#021b96" points="35.37 61.24 45.92 55.16 45.92 14.85 35.37 20.93 35.37 61.24"/>
            <polygon fill="#0089ff" points="18.66 11.36 18.66 51.59 29.2 57.68 29.2 17.38 18.66 11.36"/>
          </svg>
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">48 · 32 · 16px</span>
      </div>

      <!-- Browser tab simulation -->
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:10px;flex:1;min-width:200px;">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;width:100%;max-width:320px;">
          <div style="background:#e8e8ea;padding:8px 12px;display:flex;align-items:center;gap:8px;">
            <div style="display:flex;gap:5px;">
              <div style="width:10px;height:10px;border-radius:50%;background:#ff5f57;"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:#febc2e;"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:#28c840;"></div>
            </div>
          </div>
          <div style="padding:0;background:#f0f0f2;">
            <div style="display:inline-flex;align-items:center;gap:6px;background:var(--surface);border-radius:6px 6px 0 0;padding:7px 14px 7px 10px;margin:6px 0 0 8px;border:1px solid var(--border);border-bottom:none;">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" style="width:14px;height:14px;border-radius:2px;flex-shrink:0;">
                <rect width="64" height="64" fill="#ffffff"/>
                <polygon fill="#1c00ff" points="18.67 11.34 29.2 17.38 42.81 9.55 31.48 4.11 18.67 11.34"/>
                <polygon fill="#021b96" points="35.37 61.24 45.92 55.16 45.92 14.85 35.37 20.93 35.37 61.24"/>
                <polygon fill="#0089ff" points="18.66 11.36 18.66 51.59 29.2 57.68 29.2 17.38 18.66 11.36"/>
              </svg>
              <span style="font-size:11px;color:var(--text);font-weight:500;white-space:nowrap;">Insights By Blueprint</span>
            </div>
          </div>
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Browser tab</span>
      </div>

    </div>
  </div>

  <!-- COLORS -->
  <div class="section">
    <div class="section-label">Colors</div>
    <div class="color-grid">
      <div class="color-card">
        <div class="color-swatch" style="background:#021b96;"></div>
        <div class="color-info">
          <div class="color-name">Dark Blue</div>
          <div class="color-values">Hex: #021b96<br>RGB: 2, 27, 150<br>CMYK: 99, 82, 0, 41<br>HSB: 230, 98.67, 58.82</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#0089ff;"></div>
        <div class="color-info">
          <div class="color-name">Bright Blue</div>
          <div class="color-values">Hex: #0089ff<br>RGB: 0, 137, 255<br>CMYK: 100, 46, 0, 0<br>HSB: 207.76, 100, 100</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#1c00ff;"></div>
        <div class="color-info">
          <div class="color-name">Electric Blue</div>
          <div class="color-values">Hex: #1c00ff<br>RGB: 28, 0, 255<br>CMYK: 89, 100, 0, 0<br>HSB: 246.59, 100, 100</div>
        </div>
      </div>
      <div class="color-card">
        <div class="color-swatch" style="background:#ce415f;"></div>
        <div class="color-info">
          <div class="color-name">Rose</div>
          <div class="color-values">Hex: #ce415f<br>RGB: 206, 65, 95<br>CMYK: 13, 84, 46, 2<br>HSB: 347.23, 68.45, 80.78</div>
        </div>
      </div>
    </div>
  </div>

  <!-- TYPOGRAPHY — HEADLINE -->
  <div class="section">
    <div class="section-label">Headline typeface</div>

    <div class="type-block">
      <div class="type-block-label">Display — PP Editorial New Regular</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-family:'PP Editorial New', serif;font-weight:400;">Insights start<br>here.</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Weights</div>
      <div class="type-specimen">
        <div class="specimen-weights">
          <div class="weight-item"><div class="weight-char" style="font-family:'PP Editorial New', serif;font-weight:200;">Aa</div><div class="weight-label">Ultralight</div></div>
          <div class="weight-item"><div class="weight-char" style="font-family:'PP Editorial New', serif;font-weight:400;">Aa</div><div class="weight-label">Regular</div></div>
          <div class="weight-item"><div class="weight-char" style="font-family:'PP Editorial New', serif;font-weight:800;">Aa</div><div class="weight-label">Ultrabold</div></div>
        </div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Italic — PP Editorial New Italic</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-family:'PP Editorial New', serif;font-weight:400;font-style:italic;">Insights start<br>here.</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Italic weights</div>
      <div class="type-specimen">
        <div class="specimen-weights">
          <div class="weight-item"><div class="weight-char" style="font-family:'PP Editorial New', serif;font-weight:200;font-style:italic;">Aa</div><div class="weight-label">Ultralight</div></div>
          <div class="weight-item"><div class="weight-char" style="font-family:'PP Editorial New', serif;font-weight:400;font-style:italic;">Aa</div><div class="weight-label">Regular</div></div>
          <div class="weight-item"><div class="weight-char" style="font-family:'PP Editorial New', serif;font-weight:800;font-style:italic;">Aa</div><div class="weight-label">Ultrabold</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- TYPOGRAPHY — IMPACT -->
  <div class="section">
    <div class="section-label">Impact typeface</div>

    <div class="type-block">
      <div class="type-block-label">Display — PP Monument Normal Black</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-family:'PP Monument Normal', sans-serif;font-weight:900;text-transform:uppercase;">Insights start<br>here.</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Weights</div>
      <div class="type-specimen">
        <div class="specimen-weights">
          <div class="weight-item"><div class="weight-char" style="font-family:'PP Monument Normal', sans-serif;font-weight:900;">Aa</div><div class="weight-label">Black</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- TYPOGRAPHY — BODY -->
  <div class="section">
    <div class="section-label">Body typeface</div>

    <div class="type-block">
      <div class="type-block-label">Display — Inter SemiBold</div>
      <div class="type-specimen">
        <div class="specimen-display" style="font-family:'Inter', sans-serif;font-weight:600;">Insights start<br>here.</div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Weights</div>
      <div class="type-specimen">
        <div class="specimen-weights">
          <div class="weight-item"><div class="weight-char" style="font-family:'Inter', sans-serif;font-weight:400;">Aa</div><div class="weight-label">Regular</div></div>
          <div class="weight-item"><div class="weight-char" style="font-family:'Inter', sans-serif;font-weight:500;">Aa</div><div class="weight-label">Medium</div></div>
          <div class="weight-item"><div class="weight-char" style="font-family:'Inter', sans-serif;font-weight:600;">Aa</div><div class="weight-label">SemiBold</div></div>
        </div>
      </div>
    </div>

    <div class="type-block">
      <div class="type-block-label">Body — Inter Regular</div>
      <div class="type-specimen">
        <div class="specimen-body" style="font-family:'Inter', sans-serif;">Insights By Blueprint is the premier event for real estate data and analytics professionals. Expert panels, workshops, and networking keep you ahead of the curve.<br><br><strong style="font-weight:600;">SemiBold for emphasis.</strong> Always pair display type with adequate white space to let headings breathe.</div>
      </div>
    </div>
  </div>

  <!-- DEV GUIDE -->
  <div class="section">
    <div class="section-label">Developer guide</div>
    <p style="color:var(--text-secondary);margin-bottom:16px;">Markdown cheat sheet with CSS variables, font stacks, and color tokens for developers.</p>
    <div class="btn-row">
      <DownloadBtn href="/assets/downloads/Insights_Dev_Guide.md" label="Download Dev Guide (.md)" />
    </div>
  </div>

</BrandLayout>
