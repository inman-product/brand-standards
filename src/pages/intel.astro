---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import DownloadBtn from '../components/DownloadBtn.astro';
import PhotoWidget from '../components/PhotoWidget.astro';
import InmanIntelHorizontal from '../components/logos/InmanIntelHorizontal.astro';
import InmanIntelStacked from '../components/logos/InmanIntelStacked.astro';
import IntelIcon from '../components/logos/IntelIcon.astro';
---

<BrandLayout
  title="Intel"
  eyebrow="Products"
  titleSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1247.61 173.91" style="width:260px;height:auto;display:block;margin-top:6px;" aria-label="Inman Intel"><path fill="#0a84ff" d="M748.01,50.2v119.92h-27.55V50.2h27.55Z"/><path fill="#0a84ff" d="M805.26,50.2l54.2,77.06h.36l-.18-77.06h25.03v119.92h-27.01l-54.74-78.32h-.36l.18,78.32h-25.03V50.2h27.55Z"/><path fill="#0a84ff" d="M1011.97,50.2v23.59h-39.61v96.33h-27.37v-96.33h-39.79v-23.59h106.77Z"/><path fill="#0a84ff" d="M1125.76,50.2v22.87h-66.26v25.57h51.14v21.25h-51.14v27.37h66.26v22.87h-93.27V50.2h93.27Z"/><path fill="#0a84ff" d="M1176.9,50.2v95.97h58.16v23.95h-85.89V50.2h27.73Z"/><path fill="#161a48" d="M61.39,168.84v1.28c-7.41-.51-18.13-.51-29.11-.51s-21.45,0-29.88.51v-1.28c10.72-4.34,12.51-9.45,12.51-38.56v-42.39c0-26.56-1.79-30.64-12.51-37.28v-1.28c17.88,0,30.13-.25,47.24-.77v81.97c0,28.86,1.53,33.96,11.75,38.31Z"/><path fill="#161a48" d="M204.39,170.12c-8.43-.51-17.62-.51-28.86-.51s-20.94,0-28.6.51v-1.28c9.45-4.34,11.24-9.45,11.24-36.77v-41.62c0-14.56-7.15-21.45-18.64-21.45-10.47,0-21.71,7.15-21.71,21.71v41.63c0,27.07,1.53,32.18,11.24,36.52v1.28c-7.66-.51-17.36-.51-28.6-.51s-20.94,0-29.37.51v-1.28c10.21-4.34,12-9.45,12-36.77v-44.18c0-26.56-1.79-30.64-12-37.28v-1.28c17.88,0,29.88-.25,46.73-.77v24.77c6.89-15.32,21.45-27.32,39.84-27.32,24.52,0,35.24,16.09,35.24,38.82v47.24c0,27.32,1.79,32.43,11.49,36.77v1.28Z"/><path fill="#161a48" d="M417.86,170.12c-8.17-.51-17.62-.51-28.86-.51s-20.94,0-28.35.51v-1.28c9.45-4.34,10.98-9.45,10.98-36.77v-41.62c0-14.56-6.9-21.45-17.88-21.45-9.96,0-20.68,7.15-20.68,21.71v41.37c0,27.32,1.79,32.43,12,36.77v1.28c-8.17-.51-18.13-.51-29.37-.51s-20.94,0-28.6.51v-1.28c9.7-4.34,11.24-9.45,11.24-36.77v-41.62c0-14.56-6.89-21.45-17.88-21.45-9.96,0-20.68,7.15-20.68,21.71v41.63c0,27.07,1.53,32.18,11.24,36.52v1.28c-7.41-.51-17.36-.51-28.6-.51s-21.2,0-29.37.51v-1.28c10.21-4.34,12-9.45,12-36.77v-44.18c0-26.56-1.79-30.64-12-37.28v-1.28c17.62,0,30.13-.25,46.73-.77v24.52c6.89-15.32,21.2-27.07,38.82-27.07,20.17,0,30.9,11.49,33.71,28.6,6.38-16.09,21.2-28.6,39.58-28.6,24,0,34.47,16.09,34.47,38.82v47.24c0,27.32,2.04,32.43,11.49,36.77v1.28Z"/><path fill="#161a48" d="M493.69,157.35c-12.77,11.24-22.22,15.58-35.5,15.58-18.39,0-30.13-12.26-30.13-31.41,0-24,17.88-36.26,65.63-39.84v-15.83c0-14.56-6.64-19.66-17.62-19.66s-21.71,6.39-35.5,22.22l-1.02-.26c-.25-10.47-1.02-19.41-2.3-28.6,13.28-7.41,31.67-13.53,48.78-13.53,26.05,0,41.62,12.51,41.62,41.88v44.43c0,27.32,1.79,32.43,11.49,36.26v1.28c-17.62,0-28.6.26-45.45.77v-13.28ZM476.84,156.07c4.85,0,9.96-1.79,16.85-5.62v-34.22c-26.81,2.55-32.43,10.98-32.43,22.47s5.62,17.36,15.58,17.36Z"/><path fill="#161a48" d="M680.61,170.12c-8.43-.51-17.62-.51-28.86-.51s-20.94,0-28.6.51v-1.28c9.45-4.34,11.24-9.45,11.24-36.77v-41.62c0-14.56-7.15-21.45-18.64-21.45-10.47,0-21.71,7.15-21.71,21.71v41.63c0,27.07,1.53,32.18,11.24,36.52v1.28c-7.66-.51-17.36-.51-28.6-.51s-20.94,0-29.37.51v-1.28c10.21-4.34,12-9.45,12-36.77v-44.18c0-26.56-1.79-30.64-12-37.28v-1.28c17.88,0,29.88-.25,46.73-.77v24.77c6.89-15.32,21.45-27.32,39.84-27.32,24.52,0,35.24,16.09,35.24,38.82v47.24c0,27.32,1.79,32.43,11.49,36.77v1.28Z"/><circle fill="#0a84ff" cx="31.1" cy="19.16" r="16.97"/></svg>`}
>

  <!-- LOGOS -->
  <div class="section">
    <div class="section-label">Logos</div>

    <div class="logo-subsection-label">Horizontal</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <InmanIntelHorizontal fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light">
        <InmanIntelHorizontal fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark">
        <InmanIntelHorizontal fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue">
        <InmanIntelHorizontal fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">Stacked</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <InmanIntelStacked fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light" tall>
        <InmanIntelStacked fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark" tall>
        <InmanIntelStacked fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue" tall>
        <InmanIntelStacked fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="btn-row">
      <DownloadBtn href="#" label="Download Intel Logos" />
    </div>
  </div>

  <!-- ICONS -->
  <div class="section">
    <div class="section-label">Icons</div>
    <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:flex-end;">
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <IntelIcon fill="#161a48" dotFill="#0a84ff" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue Duo</span>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <IntelIcon fill="#0a84ff" dotFill="#0a84ff" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue</span>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;">
          <IntelIcon fill="#adafb2" dotFill="#adafb2" />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Gray</span>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
        <div style="width:100px;height:100px;border-radius:12px;background:var(--dark);display:flex;align-items:center;justify-content:center;">
          <IntelIcon fill="#fff" dotFill="#0a84ff" solid />
        </div>
        <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.04em;">Blue Solid</span>
      </div>
    </div>
    <div class="btn-row">
      <DownloadBtn href="#" label="Download Intel Icons" />
    </div>
  </div>

  <PhotoWidget />

</BrandLayout>
