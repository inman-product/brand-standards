---
import BrandLayout from '../layouts/BrandLayout.astro';
import LogoGrid from '../components/LogoGrid.astro';
import LogoTile from '../components/LogoTile.astro';
import LuxuryConnectHorizontal from '../components/logos/LuxuryConnectHorizontal.astro';
import LuxuryConnectStacked from '../components/logos/LuxuryConnectStacked.astro';
---

<BrandLayout
  title="Inman Luxury Connect"
  eyebrow="Events"
>

  <!-- LOGOS -->
  <div class="section">
    <div class="section-label">Logos</div>

    <div class="logo-subsection-label">Horizontal</div>
    <LogoGrid style="margin-bottom:16px;">
      <LogoTile bg="light">
        <LuxuryConnectHorizontal fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light">
        <LuxuryConnectHorizontal fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark">
        <LuxuryConnectHorizontal fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue">
        <LuxuryConnectHorizontal fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>

    <div class="logo-subsection-label">Stacked</div>
    <LogoGrid>
      <LogoTile bg="light" tall>
        <LuxuryConnectStacked fill="#161a48" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="light" tall>
        <LuxuryConnectStacked fill="#231f20" dotFill="#231f20" />
      </LogoTile>
      <LogoTile bg="dark" tall>
        <LuxuryConnectStacked fill="#fff" dotFill="#0a84ff" />
      </LogoTile>
      <LogoTile bg="blue" tall>
        <LuxuryConnectStacked fill="#fff" dotFill="#fff" />
      </LogoTile>
    </LogoGrid>  </div>


</BrandLayout>
