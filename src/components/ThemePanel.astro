---
export interface Props {
  brandName: string;
  colors: { name: string; hex: string; role: string }[];
  fonts: { name: string; role: string }[];
}

const { brandName, colors, fonts } = Astro.props;
---

<div class="theme-panel" data-tp>
  <div class="tp-header">
    <div class="tp-title">{brandName}</div>
  </div>

  <div class="tp-grid">
    <div class="tp-col">
      <!-- Colors -->
      <div class="tp-section-label">Color Palette</div>
      {colors.map(c => (
        <div class="tp-color-row">
          <div class="tp-color-dot" style={`background:${c.hex};`}></div>
          <div class="tp-color-info">
            <div class="tp-color-name">{c.name}</div>
            <div class="tp-color-role">{c.role}</div>
          </div>
          <div class="tp-color-hex">{c.hex}</div>
        </div>
      ))}
    </div>

    <div class="tp-col">
      <!-- Fonts -->
      <div class="tp-section-label">Font</div>
      {fonts.map(f => (
        <div class="tp-font-row">
          <div class="tp-font-icon">Aa</div>
          <div class="tp-font-info">
            <div class="tp-font-name">{f.name}</div>
            <div class="tp-font-role">{f.role}</div>
          </div>
        </div>
      ))}

    </div>
  </div>
</div>

<div class="btn-row" style="margin-top:20px;">
  <slot />
</div>


<style>
  .theme-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
  }

  .tp-header {
    margin-bottom: 4px;
  }

  .tp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 640px) {
    .tp-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  .tp-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
  }

  .tp-section-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 20px 0 10px;
  }

  .tp-color-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .tp-color-row:last-of-type {
    border-bottom: none;
  }

  .tp-color-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,0.08);
  }

  .tp-color-info {
    flex: 1;
    min-width: 0;
  }

  .tp-color-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .tp-color-role {
    font-size: 11px;
    color: var(--text-muted);
  }

  .tp-color-hex {
    font-size: 12px;
    font-family: 'SF Mono', 'Fira Code', monospace;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .tp-font-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .tp-font-row:last-of-type {
    border-bottom: none;
  }

  .tp-font-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .tp-font-info {
    flex: 1;
  }

  .tp-font-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .tp-font-role {
    font-size: 11px;
    color: var(--text-muted);
  }

</style>
