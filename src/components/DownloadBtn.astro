---
export interface Props {
  href: string;
  label: string;
}

const { href: rawHref, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = rawHref.startsWith('/') ? `${base}${rawHref}` : rawHref;
---

<a class="download-btn red" href={href}>
  {label}
  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
    <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>
